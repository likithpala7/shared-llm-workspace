# Copy this file to .env and fill in what you need. .env is gitignored and is
# read at server startup; real environment variables still win over it.

# The model the agent talks to. Without it the server falls back to a stub that
# streams a canned reply and does not call the real model.
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Signs the session cookie. Any long random string; changing it signs everyone
# out. Generate one with:  openssl rand -base64 32
COOKIE_SECRET=

# Cost controls, all optional.
# A cheaper model while developing. Default: claude-opus-5 ($5/$25 per million
# tokens in/out). claude-haiku-4-5 is $1/$5; claude-sonnet-5 is $3/$15.
# ANTHROPIC_MODEL=claude-haiku-4-5
#
# How hard the model thinks. Thinking tokens are billed as output, so low or
# medium meaningfully cuts the cost of a turn. Default: the model's own.
# AGENT_EFFORT=medium
#
# Force the free stub provider even though a key is set, so routine UI work
# costs nothing.
# LLM_PROVIDER=stub

# Sandbox, all optional.
# Where the Docker daemon listens. Auto-detected (Docker Desktop, Colima, or
# DOCKER_HOST) when unset.
# DOCKER_SOCKET=/var/run/docker.sock
#
# The image each workspace container runs. Default: node:22-alpine
# WORKSPACE_IMAGE=node:22-alpine

# How long an approval card waits for a human, in milliseconds. Default: 300000
# (five minutes). Tests set this low.
# APPROVAL_TIMEOUT_MS=300000

# Optional. Defaults shown.
# PORT=3001
# DATA_DIR=./data

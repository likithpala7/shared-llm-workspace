# Copy to /srv/slw/.env and fill in. Mode 600, owned by the slw user.
# The server refuses to start in production if the required ones are missing.

# --- required ---------------------------------------------------------------
# Where browsers will load the app from. Without this only localhost may open
# a WebSocket, and the page loads but never syncs.
ALLOWED_ORIGINS=https://workspace.example.com

# openssl rand -base64 32
COOKIE_SECRET=

# The cookie must not travel unencrypted.
COOKIE_SECURE=true

# Behind Caddy, or every caller shares one rate-limit bucket.
TRUST_PROXY=true

# Absolute, on the server's disk, backed up nightly.
DATA_DIR=/srv/slw/data

# --- the agent --------------------------------------------------------------
# Without this the agent answers from a stub rather than a model.
ANTHROPIC_API_KEY=

# --- sizing -----------------------------------------------------------------
# PORT=3001
# IDLE_CONTAINER_MINUTES=30
# WORKSPACE_MEMORY_BYTES=1073741824
# WORKSPACE_CPU_NANOS=2000000000
# LIMIT_AI_REQUESTS=40
